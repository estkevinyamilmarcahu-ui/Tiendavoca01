@model FerreteriaValdivia.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container mt-4">
    <h2>Editar Producto</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Editar" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="CodigoProducto" />
                <input type="hidden" asp-for="CantidadVendida" />

                <div class="mb-3">
                    <label asp-for="CodigoProducto" class="form-label"></label>
                    <input asp-for="CodigoProducto" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PrecioVenta" class="form-label"></label>
                    <input asp-for="PrecioVenta" type="number" step="0.01" min="0.01" class="form-control" />
                    <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StockActual" class="form-label"></label>
                    <input asp-for="StockActual" type="number" min="0" class="form-control" />
                    <span asp-validation-for="StockActual" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StockMinimo" class="form-label"></label>
                    <input asp-for="StockMinimo" type="number" min="0" class="form-control" />
                    <span asp-validation-for="StockMinimo" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
